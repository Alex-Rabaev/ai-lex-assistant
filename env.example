# Example .env file for Assistants Platform
# Copy this file to .env and fill in your actual values

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGODB_DB_NAME=assistants-platform
MONGO_DB=assistants_platform_db

# Organization (temporary for MVP)
DEFAULT_ORG_ID=AiLex_DEFAULT_org_ID

# Auth0
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_API_AUDIENCE=your-api-audience
AUTH0_ALGORITHMS=["RS256"]

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Security
# Generate a new key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=QNZiu3OqtgjY5HA0crJVxT9ySpS4ra4GBXfzNYtnVoY=
WEBHOOK_BASE_URL=https://platform.ai-lex.com

# Logging
LOG_LEVEL=INFO

# Telegram Bots (for existing legacy bot)
TG_BOT_TOKEN=your-telegram-bot-token
TG_TESTBOT_TOKEN=your-test-bot-token

# WhatsApp (for existing legacy integration)
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_VERSION=v22.0
WHATSAPP_APP_ID=your-app-id
WHATSAPP_APP_SECRET=your-app-secret
WHATSAPP_WEBHOOK_HOST=https://your-domain.com

# LangSmith (optional)
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=your-project
LANGSMITH_WORKSPACE_ID=your-workspace-id

# Other
WEBHOOK_SECRET=your-webhook-secret
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE_NAME=messages

# WEBSOCKET (WebChat)
WEBSOCKET_WORKER_HOST=0.0.0.0
WEBSOCKET_WORKER_PORT=8001

# Temporal
TEMPORAL_HOST=eu-central-1.aws.api.temporal.io:7233
TEMPORAL_NAMESPACE=<namespace>.<account>
TEMPORAL_TASK_QUEUE=analysis-workflows
TEMPORAL_MAX_CONCURRENT_ACTIVITIES=5
TEMPORAL_MAX_CONCURRENT_WORKFLOWS=10
TEMPORAL_API_KEY=<your-api-key>